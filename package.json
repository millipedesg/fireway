{
  "name": "@millipedesg/fireway",
  "version": "1.2.6",
  "description": "Schema migration tool for Firestore",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/millipedesg/fireway.git"
  },
  "types": "fireway.d.ts",
  "keywords": [
    "schema",
    "migration",
    "firestore",
    "typescript"
  ],
  "files": [
    "/src",
    "LICENSE",
    "README.md",
    "fireway.d.ts"
  ],
  "main": "src/index.js",
  "bin": {
    "fireway": "src/cli.js"
  },
  "author": "mudassirmaroof <mudassir89@gmail.com>",
  "license": "MIT",
  "scripts": {
    "setup": "node ./node_modules/firebase-tools/lib/bin/firebase.js setup:emulators:firestore",
    "emulator": "node ./node_modules/firebase-tools/lib/bin/firebase.js emulators:start --only firestore --project fireway-ci",
    "test-runner": "node tests",
    "pretest": "mkdir -p tests/emptyMigration",
    "test": "node ./node_modules/firebase-tools/lib/bin/firebase.js emulators:exec --only firestore --project fireway-ci \"yarn test-runner\"",
    "release": "echo 'Use GitHub Actions: Publish @millipedesg/fireway (tag push or workflow_dispatch)' && exit 1"
  },
  "husky": {
    "hooks": {
      "pre-push": "yarn test"
    }
  },
  "dependencies": {
    "@google-cloud/firestore": "^7.11.6",
    "callsites": "^3.1.0",
    "md5": "^2.3.0",
    "sade": "^1.8.1",
    "semver": "^7.7.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/node": "^22.14.1",
    "capture-console": "^1.0.2",
    "firebase": "^11.10.0",
    "firebase-tools": "^15.35.0",
    "husky": "^9.1.7",
    "start-server-and-test": "^2.1.5",
    "tape": "^5.10.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "resolutions": {
    "@grpc/grpc-js": "^1.13.6"
  }
}
